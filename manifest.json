{
  "manifest_version": 3,
  "name": "糖心志者",
  "version": "5.1.3",
  "key": "",
  "description": "可爱风账号小屋、智能放映、下载收纳、服务体检与安全升级工作台。",
  "permissions": [
    "storage",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://txh068.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://txh068.com/*"
      ],
      "js": [
        "page_context_core.js",
        "content.js",
        "dist-ui/txzz-ui.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "糖心志者"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "nav_guard.js",
        "page_context_core.js",
        "page_hook.js",
        "page_probe.js",
        "display_patch.js",
        "download_core.js",
        "dist-ui/txzz-ui.css",
        "README.md",
        "vendor/mux-7.0.0.min.js",
        "vendor/m3u8-parser-7.2.0.min.js"
      ],
      "matches": [
        "https://txh068.com/*"
      ]
    }
  ]
}
