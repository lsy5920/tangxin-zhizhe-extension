{
  "name": "tangxin-zhizhe-extension",
  "private": true,
  "version": "5.8.0",
  "type": "module",
  "scripts": {
    "deps:check": "node scripts/check-deps.mjs",
    "deps:repair": "node scripts/check-deps.mjs --repair",
    "prebuild": "node scripts/check-deps.mjs",
    "build": "vite build",
    "precheck": "node scripts/check-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:prepack": "node scripts/check-release.mjs --prepack",
    "check:release-source": "node scripts/check-release.mjs --source-only",
    "check:release": "node scripts/check-release.mjs",
    "check": "tsc --noEmit && vite build && node scripts/check-release.mjs --prepack",
    "pack": "node scripts/pack-crx.mjs",
    "release": "node scripts/check-deps.mjs && tsc --noEmit && vitest run && node scripts/pack-crx.mjs && node scripts/check-release.mjs"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "m3u8-parser": "7.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shaka-player": "5.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/chrome": "0.2.2",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "3.2.7"
  }
}
