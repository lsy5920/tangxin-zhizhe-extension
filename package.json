{
  "name": "tangxin-zhizhe-extension",
  "private": true,
  "version": "5.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "deps:check": "node scripts/check-deps.mjs",
    "deps:repair": "node scripts/check-deps.mjs --repair",
    "prebuild": "node scripts/check-deps.mjs",
    "build": "vite build",
    "precheck": "node scripts/check-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:release-source": "node scripts/check-release.mjs --source-only",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run typecheck && vite build && npm run check:release-source",
    "pack": "node scripts/pack-crx.mjs",
    "release": "npm run check && npm run pack && npm run check:release"
  },
  "dependencies": {
    "artplayer": "5.4.0",
    "hls.js": "1.6.16",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/chrome": "0.2.2",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "crx": "5.0.1",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vitest": "3.2.4",
    "vite": "8.1.4"
  }
}
